{% liquid
  assign journal_back_url = section.settings.back_url | default: blog.url
  assign editorial_blocks = article.metafields[section.settings.editorial_namespace].editorial_blocks.value
  assign related_products = article.metafields[section.settings.editorial_namespace].related_products.value
  assign related_stories = article.metafields[section.settings.editorial_namespace].related_stories.value
%}
<article class="ro-article journal-article-page" style="--ra-paper: {{ section.settings.background }}; --ra-ink: {{ section.settings.text_color }}; --ra-heading: {{ section.settings.heading_color }}; --ra-body-width: {{ section.settings.body_width }}px; --ra-body-size: {{ section.settings.body_size }}px; --ra-title-size: {{ section.settings.title_size }}px;">
  <div class="ro-article__inner">
    <header class="ro-article__header">
      <a class="ro-article__journal" href="{{ journal_back_url }}">{{ blog.title | default: 'Journal' | escape }}</a>
      {% if section.settings.show_date %}<time class="ro-article__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>{% endif %}
      <h1>{{ article.title | escape }}</h1>
      {% if section.settings.show_categories and article.tags.size > 0 %}<p class="ro-article__categories">{{ article.tags | join: ', ' | escape }}</p>{% endif %}
      {% if section.settings.show_excerpt and article.excerpt != blank %}<div class="ro-article__excerpt">{{ article.excerpt }}</div>{% endif %}
      {% if section.settings.show_author %}
        <div class="ro-article__meta">
          {% if section.settings.show_author and article.author != blank %}<span>{{ article.author | escape }}</span>{% endif %}
        </div>
      {% endif %}
    </header>
    {% if section.settings.show_featured_image and article.image %}
      <figure class="ro-article__hero">
        {{ article.image | image_url: width: 2200 | image_tag: widths: '480, 720, 1080, 1440, 1800, 2200', sizes: '(min-width: 1240px) 1120px, 94vw', loading: 'eager', fetchpriority: 'high', alt: article.image.alt }}
        {% if section.settings.show_image_caption and article.image.alt != blank %}<figcaption>{{ article.image.alt | escape }}</figcaption>{% endif %}
      </figure>
    {% endif %}
    <div class="ro-article__body journal-body">{{ article.content }}</div>
    {% if section.settings.show_editorial and editorial_blocks != blank %}
      <div class="ro-article__body ro-editorial">
        {% for editorial in editorial_blocks limit: 50 %}
          {% assign editorial_layout = editorial.layout.value %}
          {% case editorial_layout %}
            {% when 'text' %}
              {% if editorial.text.value != blank %}<div class="ro-editorial__text">{{ editorial.text.value | escape | newline_to_br }}</div>{% endif %}
            {% when 'pull_quote' %}
              {% if editorial.text.value != blank %}<blockquote>{{ editorial.text.value | escape | newline_to_br }}</blockquote>{% endif %}
            {% when 'image', 'wide_image', 'two_images', 'image_text' %}
              <div class="ro-editorial__images{% if editorial_layout == 'two_images' %} journal-pair{% elsif editorial_layout == 'image_text' %} journal-image-text{% endif %}{% if editorial_layout == 'wide_image' %} journal-wide{% endif %}">
                {% if editorial.image_url.value != blank %}
                  <figure{% if editorial_layout == 'wide_image' %} class="journal-wide"{% endif %}>
                    <img src="{{ editorial.image_url.value | escape }}" alt="{{ editorial.alt.value | escape }}" loading="lazy" width="1600" height="1200">
                    {% if editorial.caption.value != blank %}<figcaption>{{ editorial.caption.value | escape | newline_to_br }}</figcaption>{% endif %}
                  </figure>
                {% endif %}
                {% if editorial_layout == 'two_images' and editorial.second_image_url.value != blank %}
                  <figure><img src="{{ editorial.second_image_url.value | escape }}" alt="{{ editorial.second_alt.value | escape }}" loading="lazy" width="1600" height="1200">{% if editorial.second_caption.value != blank %}<figcaption>{{ editorial.second_caption.value | escape | newline_to_br }}</figcaption>{% endif %}</figure>
                {% endif %}
                {% if editorial_layout == 'image_text' and editorial.text.value != blank %}<div>{{ editorial.text.value | escape | newline_to_br }}</div>{% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
    {% if section.settings.show_related_products and related_products != blank %}
      <section class="ro-article__related" aria-labelledby="RelatedProducts-{{ section.id }}"><h2 id="RelatedProducts-{{ section.id }}">{{ section.settings.products_heading | escape }}</h2><div class="ro-article__related-grid">
        {% for product in related_products limit: 12 %}{% if product.url != blank %}<article><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: widths: '320, 480, 720', sizes: '(min-width: 750px) 30vw, 90vw', loading: 'lazy', alt: product.featured_image.alt }}{% endif %}<h3>{{ product.title | escape }}</h3></a></article>{% endif %}{% endfor %}
      </div></section>
    {% endif %}
    {% if section.settings.show_related_stories and related_stories != blank %}
      <section class="ro-article__related" aria-labelledby="RelatedStories-{{ section.id }}"><h2 id="RelatedStories-{{ section.id }}">{{ section.settings.stories_heading | escape }}</h2><div class="ro-article__related-grid">
        {% for story in related_stories limit: 12 %}{% if story.url != blank %}<article><a href="{{ story.url }}">{% if story.image %}{{ story.image | image_url: width: 720 | image_tag: widths: '320, 480, 720', sizes: '(min-width: 750px) 30vw, 90vw', loading: 'lazy', alt: story.image.alt }}{% endif %}<h3>{{ story.title | escape }}</h3></a></article>{% endif %}{% endfor %}
      </div></section>
    {% endif %}
    <footer class="ro-article__footer">
      <a class="ro-article__back" href="{{ journal_back_url }}"><span aria-hidden="true">&#8592;</span> {{ section.settings.back_label | escape }}</a>
      {% if section.settings.show_navigation %}
        {% if blog.previous_article or blog.next_article %}
          <nav class="ro-article__navigation" aria-label="{{ section.settings.back_label | escape }}">
            <div>{% if blog.previous_article %}<a href="{{ blog.previous_article.url }}"><span class="ro-article__nav-label">{{ section.settings.previous_label | escape }}</span><span>{{ blog.previous_article.title | escape }}</span></a>{% endif %}</div>
            <div>{% if blog.next_article %}<a href="{{ blog.next_article.url }}"><span class="ro-article__nav-label">{{ section.settings.next_label | escape }}</span><span>{{ blog.next_article.title | escape }}</span></a>{% endif %}</div>
          </nav>
        {% endif %}
      {% endif %}
    </footer>
  </div>
</article>
{% stylesheet %}
.ro-article{background:var(--ra-paper);color:var(--ra-ink);padding:34px 28px 72px}.ro-article *{box-sizing:border-box}.ro-article__inner{max-width:1120px;margin:0 auto}.ro-article a{color:var(--ra-heading);text-underline-offset:4px}.ro-article a:focus-visible{outline:2px solid currentColor;outline-offset:5px}.ro-article__back{display:inline-flex;gap:10px;align-items:center;font-size:12px;line-height:1.5;text-decoration:none}.ro-article__back:hover{text-decoration:underline}.ro-article__header{max-width:880px;margin:42px auto 38px;text-align:center}.ro-article__categories{font:italic 13px/1.5 Georgia,"Times New Roman",serif;color:var(--ra-heading);margin:0 0 14px}.ro-article h1{font-family:var(--font-heading-family,Georgia,"Times New Roman",serif);font-weight:400;font-size:var(--ra-title-size);line-height:1.12;letter-spacing:-.025em;color:var(--ra-heading);margin:0;text-wrap:balance}.ro-article__excerpt{max-width:620px;margin:20px auto 0;font-family:Georgia,"Times New Roman",serif;font-size:18px;line-height:1.6;color:var(--ra-heading)}.ro-article__excerpt p{margin:0}.ro-article__meta{display:flex;align-items:center;justify-content:center;gap:10px 22px;flex-wrap:wrap;margin-top:20px;font-size:11px;letter-spacing:.04em;opacity:.65}.ro-article__hero{margin:0 0 44px}.ro-article__hero img{display:block;width:100%;height:auto;max-height:760px;object-fit:contain}.ro-article figcaption{font-size:12px;line-height:1.6;color:var(--ra-heading);margin-top:10px;text-align:center}.ro-article__body{font-size:var(--ra-body-size);line-height:1.85;overflow-wrap:anywhere}.ro-article__body>p,.ro-article__body>h2,.ro-article__body>h3,.ro-article__body>h4,.ro-article__body>ul,.ro-article__body>ol,.ro-article__body>table{max-width:var(--ra-body-width);margin-left:auto;margin-right:auto}.ro-article__body p{margin-top:0;margin-bottom:1.3em}.ro-article__body h2,.ro-article__body h3,.ro-article__body h4{font-family:var(--font-heading-family,Georgia,"Times New Roman",serif);font-weight:400;color:var(--ra-heading);line-height:1.3;margin-top:2em;margin-bottom:.7em}.ro-article__body h2{font-size:1.7em}.ro-article__body h3{font-size:1.35em}.ro-article__body img{display:block;max-width:100%;height:auto}.ro-article__body figure{max-width:var(--ra-body-width);margin:36px auto}.ro-article__body figure img{width:100%}.ro-article__body picture{display:block}.ro-article__body .captioned-image-container{margin:36px 0}.ro-article__body .captioned-image-container figure{margin-top:0;margin-bottom:0}.ro-article__body blockquote{max-width:850px;margin:50px auto;padding:0 24px;border:0;text-align:center;color:var(--ra-heading);font-family:Georgia,"Times New Roman",serif;font-size:clamp(24px,3vw,36px);line-height:1.45;font-style:italic}.ro-article__body blockquote p{margin:0}.ro-article__body .journal-wide{max-width:1120px}.ro-article__body .journal-pair,.ro-article__body .journal-image-text,.ro-article__body .journal-related{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;max-width:1120px;margin:40px auto}.ro-article__body .journal-pair figure,.ro-article__body .journal-image-text figure{margin:0;max-width:none}.ro-article__body .journal-image-text{align-items:center}.ro-article__body .journal-image-text>div{padding:12px 20px}.ro-article__body .journal-related{font-size:16px;border-top:1px solid color-mix(in srgb,var(--ra-ink) 18%,transparent);padding-top:24px}.ro-article__body table{display:block;overflow:auto;max-width:100%}.ro-article__body iframe,.ro-article__body video{max-width:100%}.ro-article__footer{margin:56px auto 0;max-width:var(--ra-body-width)}.ro-article__navigation{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px;border-top:1px solid color-mix(in srgb,var(--ra-ink) 20%,transparent);margin-top:28px;padding-top:24px}.ro-article__navigation>div:last-child{text-align:right}.ro-article__navigation a{text-decoration:none;font-family:Georgia,"Times New Roman",serif;font-size:19px;line-height:1.4}.ro-article__navigation a:hover>span:last-child{text-decoration:underline}.ro-article__nav-label{display:block;font-family:inherit;font-size:11px;opacity:.65;margin-bottom:8px}@media(max-width:749px){.ro-article{padding:24px 20px 44px}.ro-article__header{margin:32px auto 28px}.ro-article h1{font-size:clamp(30px,7vw,var(--ra-title-size));line-height:1.16}.ro-article__excerpt{font-size:16px;margin-top:16px}.ro-article__meta{margin-top:16px;font-size:10px}.ro-article__hero{margin-bottom:30px}.ro-article__body{font-size:clamp(15px,var(--ra-body-size),18px);line-height:1.8}.ro-article__body figure,.ro-article__body .captioned-image-container{margin:28px auto}.ro-article__body .journal-pair,.ro-article__body .journal-image-text,.ro-article__body .journal-related{grid-template-columns:1fr;gap:24px}.ro-article__body .journal-image-text>div{padding:0}.ro-article__body blockquote{padding:0;margin:36px auto}.ro-article__navigation{gap:20px}.ro-article__navigation a{font-size:16px}.ro-article__footer{margin-top:40px}}
.ro-editorial{margin-top:40px}.ro-editorial__text{max-width:var(--ra-body-width);margin:28px auto}.ro-editorial__images{margin:36px auto}.ro-editorial__images:not(.journal-wide):not(.journal-pair):not(.journal-image-text){max-width:var(--ra-body-width)}.ro-editorial__images img{height:auto}.ro-article__related{border-top:1px solid color-mix(in srgb,var(--ra-ink) 18%,transparent);padding-top:32px;margin-top:48px}.ro-article__related>h2{font:400 28px/1.3 Georgia,"Times New Roman",serif;color:var(--ra-heading);margin:0 0 24px}.ro-article__related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.ro-article__related-grid a{text-decoration:none}.ro-article__related-grid img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;display:block}.ro-article__related-grid h3{font:400 19px/1.4 Georgia,"Times New Roman",serif;margin:14px 0 0}.ro-article__related-grid a:hover h3{text-decoration:underline}@media(max-width:749px){.ro-article__related-grid{grid-template-columns:1fr;gap:28px}}
/* Editorial proportions from the supplied Journal reference. */
.ro-article{padding:42px 28px 64px;font-family:Georgia,"Times New Roman",serif}.ro-article__inner{max-width:1040px}.ro-article__header{max-width:700px;margin:0 auto 64px}.ro-article__journal{display:inline-block;font-size:42px;font-weight:400;line-height:1.2;text-decoration:none}.ro-article__date{display:block;font-size:13px;line-height:1.5;margin:16px 0}.ro-article h1{font-family:Georgia,"Times New Roman",serif;font-size:var(--ra-title-size);line-height:1.35;letter-spacing:0;color:var(--ra-ink)}.ro-article__categories{margin:10px 0 0;font-size:13px;color:var(--ra-ink)}.ro-article__body{font-family:Georgia,"Times New Roman",serif;line-height:1.6}.ro-article__body>div:not(.captioned-image-container):not(.journal-wide):not(.journal-pair):not(.journal-image-text):not(.ro-editorial__images){max-width:var(--ra-body-width);margin-left:auto;margin-right:auto}.ro-article__body figure,.ro-article__body .captioned-image-container{max-width:100%;margin:40px auto}.ro-article__body .captioned-image-container figure{margin:0}.ro-article__body p:has(img),.ro-article__body p:has(picture){max-width:100%;margin:40px auto}.ro-article__body img{margin-left:auto;margin-right:auto}.ro-article figcaption,.ro-article__body .image-caption{font-family:Arial,sans-serif;font-size:10px;line-height:1.5;text-align:left;text-transform:uppercase;letter-spacing:.04em;margin-top:9px;color:var(--ra-ink)}.ro-article__body .journal-wide{max-width:100%}.ro-article__body .journal-pair,.ro-article__body .journal-image-text{gap:24px}.ro-article__body .journal-pair figure,.ro-article__body .journal-image-text figure{margin:0}.ro-article__body .journal-image-text{align-items:start}.ro-article__body blockquote{max-width:var(--ra-body-width);font-size:28px;line-height:1.5}.ro-article__body .journal-image-text>div{padding:0 12px}@media(max-width:749px){.ro-article{padding:30px 20px 44px}.ro-article__journal{font-size:32px}.ro-article__header{margin:0 auto 42px}.ro-article h1{font-size:clamp(22px,5vw,var(--ra-title-size))}.ro-article__date{font-size:12px;margin:12px 0}.ro-article__body figure,.ro-article__body .captioned-image-container,.ro-article__body p:has(img){margin:28px auto}.ro-article__body .journal-pair figure,.ro-article__body .journal-image-text figure{margin:0}.ro-article__body .journal-image-text>div{padding:0}}

/* Inner article styles are separate from the Journal listing. */
.journal-article-page{width:100%;max-width:100%;min-width:0}
.journal-article-page .ro-article__inner{max-width:1120px;min-width:0}
.journal-article-page .ro-article__header{margin-bottom:30px}
.journal-article-page .ro-article__hero{max-width:1120px;margin:0 auto 40px}
.journal-article-page .ro-article__hero img{max-height:none;object-fit:contain}
.journal-article-page .ro-article__body figure,.journal-article-page .ro-article__body .captioned-image-container,.journal-article-page .ro-article__body p:has(img){max-width:930px;margin:40px auto}
.journal-article-page .ro-article__body .captioned-image-container figure{margin:0;max-width:100%}
.journal-article-page .ro-article__body .journal-wide{max-width:1120px}
.journal-article-page .ro-article__body .journal-pair{max-width:930px;gap:24px}
.journal-article-page .ro-article__body .journal-pair figure{max-width:100%;margin:0;min-width:0}
.journal-article-page .ro-article__body .journal-pair img{width:100%;aspect-ratio:1/1;object-fit:cover}
.journal-article-page .ro-article__body .journal-image-text{max-width:var(--ra-body-width);grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;align-items:start}
.journal-article-page .ro-article__body .journal-image-text figure{grid-column:2;grid-row:1;margin:0;min-width:0}
.journal-article-page .ro-article__body .journal-image-text>div{grid-column:1;grid-row:1;padding:0;min-width:0}
.journal-article-page .ro-article__body .journal-image-text p{margin-top:0}
.journal-article-page .ro-article__body blockquote{max-width:var(--ra-body-width);margin:44px auto;font-weight:400;font-size:28px;line-height:1.45}
.journal-article-page .ro-article__body figcaption{font-size:10px;line-height:1.5;text-align:left}
@media(max-width:749px){.journal-article-page .ro-article__body .journal-image-text{grid-template-columns:1fr;gap:22px}.journal-article-page .ro-article__body .journal-image-text>div{grid-column:1;grid-row:1}.journal-article-page .ro-article__body .journal-image-text figure{grid-column:1;grid-row:2}.journal-article-page .ro-article__body .journal-pair{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.journal-article-page .ro-article__body figure,.journal-article-page .ro-article__body .captioned-image-container,.journal-article-page .ro-article__body p:has(img){margin:28px auto}.journal-article-page .ro-article__body .journal-pair figure,.journal-article-page .ro-article__body .journal-image-text figure{margin:0}.journal-article-page .ro-article__body blockquote{font-size:23px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Journal article",
  "settings": [
    {
      "type": "url",
      "id": "back_url",
      "label": "Back to Journal URL",
      "info": "Leave blank to return to the article blog."
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "Back to Journal"
    },
    {
      "type": "checkbox",
      "id": "show_categories",
      "label": "Show categories",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show original publication date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt below title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image_caption",
      "label": "Use featured image description as caption",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show previous and next stories",
      "default": true
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous story label",
      "default": "Previous story"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next story label",
      "default": "Next story"
    },
    {
      "type": "range",
      "id": "body_width",
      "label": "Reading width",
      "min": 560,
      "max": 840,
      "step": 20,
      "default": 700,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 15,
      "max": 22,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Desktop title size",
      "min": 22,
      "max": 72,
      "step": 2,
      "default": 54,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#30382F"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and links",
      "default": "#667776"
    },
    {
      "type": "header",
      "content": "App editorial content"
    },
    {
      "type": "text",
      "id": "editorial_namespace",
      "label": "Editorial metafield namespace",
      "default": "app--437612380161",
      "info": "App-owned namespace for this Roseland app installation."
    },
    {
      "type": "checkbox",
      "id": "show_editorial",
      "label": "Show saved editorial blocks after the body",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related_products",
      "label": "Show related products",
      "default": true
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Related products heading",
      "default": "Related products"
    },
    {
      "type": "checkbox",
      "id": "show_related_stories",
      "label": "Show related Journal stories",
      "default": true
    },
    {
      "type": "text",
      "id": "stories_heading",
      "label": "Related stories heading",
      "default": "More from the Journal"
    }
  ]
}
{% endschema %}
